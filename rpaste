#!/usr/bin/env bash
# rpaste — content bridge for pasting images into terminal agents over SSH.
# https://github.com/roysupriyo10/rpaste
set -euo pipefail

RPASTE_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/rpaste"
RPASTE_IMAGES="$RPASTE_STATE/images"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

die()  { printf 'rpaste: %s\n' "$*" >&2; exit 1; }
info() { printf 'rpaste: %s\n' "$*" >&2; }

ensure_dirs() { (umask 077; mkdir -p "$RPASTE_IMAGES"); }

self_path() {
  python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}"
}

python_helper() {
  local module=$1
  shift
  python3 "$(dirname "$(self_path)")/$module" "$@"
}

ssh_source_ip() {
  # tmux refreshes this client environment when attaching. Its original server
  # environment can belong to a different login or clipboard source.
  local connection="${SSH_CONNECTION:-}"
  if [ -n "${TMUX:-}" ] && [ "${RPASTE_CLIENT_CONTEXT:-}" != 1 ] && command -v tmux >/dev/null 2>&1; then
    local current
    current=$(tmux show-environment SSH_CONNECTION 2>/dev/null) || current=""
    case "$current" in SSH_CONNECTION=*) connection=${current#SSH_CONNECTION=} ;; esac
  fi
  if [ -n "$connection" ]; then
    printf '%s' "${connection%% *}"
    return
  fi
  # Prefer the utmpx database (via `who`) — it reflects the current TTY's
  # actual SSH session, not the possibly-stale inherited $SSH_CONNECTION.
  local cur_tty
  cur_tty=$(tty 2>/dev/null | sed 's|/dev/||') || true
  if [ -n "$cur_tty" ] && [ "$cur_tty" != "not a tty" ]; then
    local ip
    ip=$(who | awk -v t="$cur_tty" '$2 == t {gsub(/[()]/, "", $NF); print $NF; exit}')
    [ -n "$ip" ] && { printf '%s' "$ip"; return; }
  fi
  die "cannot identify this SSH source; use rpaste pull user@host or RPASTE_HOST"
}

resolve_host() {
  local ip=$1
  if command -v tailscale >/dev/null 2>&1; then
    local name
    name=$(tailscale status --json 2>/dev/null \
      | python3 -c "
import sys, json
d = json.load(sys.stdin)
for k, v in d.get('Peer', {}).items():
    for a in v.get('TailscaleIPs', []):
        if a == '$ip':
            print(v['HostName']); sys.exit(0)
for a in d.get('Self', {}).get('TailscaleIPs', []):
    if a == '$ip':
        print(d['Self']['HostName']); sys.exit(0)
" 2>/dev/null) && [ -n "$name" ] && { printf '%s' "$name"; return; }
  fi
  printf '%s' "$ip"
}

linux_clipboard_env() {
  # Reverse SSH does not carry the source desktop environment. Both image and
  # text reads use the same recovery from Sway's systemd user environment.
  if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    local session_env key value socket
    session_env=$(systemctl --user show-environment 2>/dev/null) || session_env=""
    while IFS='=' read -r key value; do
      case "$key" in
        WAYLAND_DISPLAY|DISPLAY|XDG_RUNTIME_DIR|XAUTHORITY) export "$key=$value" ;;
      esac
    done <<< "$session_env"
    if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
      export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi
    if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
      for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
        [ -S "$socket" ] || continue
        export WAYLAND_DISPLAY="${socket##*/}"
        break
      done
    fi
  fi
}

# ---------------------------------------------------------------------------
# Subcommand: get
# Extract clipboard image on the LOCAL machine, write to stdout.
# ---------------------------------------------------------------------------

cmd_get() {
  # This command must read the actual source clipboard, never staged remote
  # data or the injection library inherited from an agent's environment.
  unset DYLD_INSERT_LIBRARIES
  case "$(uname -s)" in
    Darwin)
      local console_user
      console_user=$(stat -f "%Su" /dev/console 2>/dev/null || echo "")
      if [ -n "$console_user" ] && [ "$console_user" != "$(whoami)" ]; then
        local gui_host
        gui_host=$(hostname -s 2>/dev/null || hostname)
        local gui_cmd='
          if command -v rpaste >/dev/null 2>&1; then rpaste get
          elif [ -x "$HOME/.local/bin/rpaste" ]; then "$HOME/.local/bin/rpaste" get
          else echo "rpaste: not found" >&2; exit 1
          fi
        '
        ssh -o BatchMode=yes -o ConnectTimeout=5 "$console_user@$gui_host" "$gui_cmd" 2>/dev/null \
          || ssh -o BatchMode=yes -o ConnectTimeout=5 "$console_user@localhost" "$gui_cmd" 2>/dev/null \
          || die "cannot reach GUI user $console_user"
        return
      fi

      if [ -x "$RPASTE_STATE/rpaste-get" ]; then
        "$RPASTE_STATE/rpaste-get" || die "no image in clipboard"
      elif command -v pngpaste >/dev/null 2>&1; then
        pngpaste - 2>/dev/null || die "no image in clipboard"
      else
        # AppleScript is built into macOS; no Swift runtime or pngpaste install
        # is needed for the default path delivery method.
        osascript -e 'the clipboard as «class PNGf»' 2>/dev/null | python3 -c '
import re,sys
match=re.fullmatch(r"«data PNGf([0-9a-fA-F]+)»", sys.stdin.read().strip())
if not match: sys.exit(1)
sys.stdout.buffer.write(bytes.fromhex(match.group(1)))
' || die "no image in clipboard"
      fi
      ;;
    Linux)
      linux_clipboard_env
      if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        wl-paste -t image/png 2>/dev/null || die "no image in clipboard (wl-paste)"
      else
        local real_xclip
        real_xclip=$(_find_real_xclip) || die "xclip is missing; run dotfiles/install.sh"
        "$real_xclip" -selection clipboard -t image/png -o 2>/dev/null || die "no image in clipboard (xclip)"
      fi
      ;;
    *)
      die "unsupported OS: $(uname -s)"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Subcommand: stage
# Save stdin (image bytes) to the staging directory.
# Returns the path to the staged file.
# ---------------------------------------------------------------------------

cmd_stage() {
  python_helper rpaste_image.py "$RPASTE_STATE"
}

cmd_get_text() {
  unset DYLD_INSERT_LIBRARIES
  case "$(uname -s)" in
    Darwin) pbpaste ;;
    Linux)
      linux_clipboard_env
      if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        wl-paste --no-newline --type text
      else
        local real_xclip
        real_xclip=$(_find_real_xclip) || return 1
        "$real_xclip" -selection clipboard -t UTF8_STRING -o
      fi
      ;;
    *) die "unsupported clipboard platform" ;;
  esac
}

cmd_pull_text() {
  if [ -n "${RPASTE_SOCKET:-}" ] && [ -z "${RPASTE_HOST:-}" ]; then
    python_helper rpaste_transport.py fetch "$RPASTE_SOCKET" --text
    return
  fi
  local host="${RPASTE_HOST:-}"
  if [ -z "$host" ]; then
    host=$(resolve_host "$(ssh_source_ip)")
  fi
  [[ "$host" != -* ]] || die "invalid SSH host: $host"
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" '
    if command -v rpaste >/dev/null 2>&1; then rpaste get-text
    else "$HOME/.local/bin/rpaste" get-text
    fi
  '
}

cmd_local() {
  ensure_dirs
  local incoming dest
  incoming=$(mktemp "$RPASTE_STATE/incoming-XXXXXX")
  if ! (cmd_get) > "$incoming"; then
    rm -f "$incoming"
    return 1
  fi
  dest=$(cmd_stage < "$incoming") || { rm -f "$incoming"; return 1; }
  rm -f "$incoming"
  printf '%s' "$dest"
}

# ---------------------------------------------------------------------------
# Subcommand: pull
# SSH back to the source machine, run `rpaste get`, stage locally.
# ---------------------------------------------------------------------------

cmd_pull() {
  local host="${1:-${RPASTE_HOST:-}}"
  local incoming dest
  ensure_dirs
  incoming=$(mktemp "$RPASTE_STATE/incoming-XXXXXX")
  if [ -z "$host" ] && [ -n "${RPASTE_SOCKET:-}" ]; then
    if ! python_helper rpaste_transport.py fetch "$RPASTE_SOCKET" > "$incoming"; then
      rm -f "$incoming"
      return 1
    fi
    dest=$(cmd_stage < "$incoming") || { rm -f "$incoming"; return 1; }
    rm -f "$incoming"
    printf '%s' "$dest"
    return
  fi
  if [ -z "$host" ]; then
    local ip
    ip=$(ssh_source_ip) || { rm -f "$incoming"; return 1; }
    host=$(resolve_host "$ip")
  fi
  info "pulling clipboard from $host"

  local remote_cmd='
    if command -v rpaste >/dev/null 2>&1; then rpaste get
    elif [ -x "$HOME/.local/bin/rpaste" ]; then "$HOME/.local/bin/rpaste" get
    else echo "rpaste: not found on remote" >&2; exit 1
    fi
  '
  [[ "$host" != -* ]] || die "invalid SSH host: $host"
  if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "$remote_cmd" > "$incoming"; then
    rm -f "$incoming"
    die "failed to pull clipboard from $host (check reverse SSH user and access)"
  fi
  dest=$(cmd_stage < "$incoming") || { rm -f "$incoming"; return 1; }
  rm -f "$incoming"
  info "staged: $dest"
  printf '%s' "$dest"
}

# ---------------------------------------------------------------------------
# Subcommand: paste
# Full flow: pull from source, stage, print path.
# ---------------------------------------------------------------------------

cmd_paste() {
  local host="${1:-}"
  local img
  if [ -n "$host" ] || [ -n "${RPASTE_HOST:-}" ] || [ -n "${SSH_CONNECTION:-}" ] || [ -n "${RPASTE_SOCKET:-}" ]; then
    img=$(cmd_pull "$host")
  else
    img=$(cmd_local)
  fi
  if [ "$(uname -s)" = Linux ] && [ -n "${SSH_CONNECTION:-}" ]; then
    cmd_publish "$img" "${RPASTE_NATIVE_STATE:-$RPASTE_STATE}"
  fi
  # Do not replace the source clipboard with a path: that destroys the image
  # and makes the next pull fail. Agents read the image from their clipboard.
  printf '%s\n' "$img"
  info "image staged (inside tmux, use Ctrl+V or prefix+v to attach)"
}

cmd_run() {
  [ "${1:-}" != -- ] || shift
  [ "$#" -gt 0 ] || die "usage: rpaste run -- command [args...]"
  exec python3 "$(dirname "$(self_path)")/rpaste_agent.py" "$RPASTE_STATE" "$@"
}

cmd_publish() {
  local image=$1 state=${2:-${RPASTE_NATIVE_STATE:-$RPASTE_STATE}}
  case "$(uname -s)" in
    Linux) python_helper rpaste_display.py publish "$state" "$image" ;;
    Darwin)
      mkdir -p "$state/images"
      ln -sf "$image" "$state/images/latest.png"
      ;;
    *) die "native clipboard supports Linux and macOS" ;;
  esac
}

# ---------------------------------------------------------------------------
# Subcommand: serve
# Act as an xclip shim (Linux). Called when symlinked as 'xclip'.
# ---------------------------------------------------------------------------

cmd_serve() {
  # Native agents use a real private X11 clipboard. Local desktop reads also
  # bypass staging, so an old image never shadows the local clipboard.
  if [ -n "${RPASTE_NATIVE_STATE:-}" ] || [ -z "${SSH_CONNECTION:-}" ]; then
    local real_xclip
    real_xclip=$(_find_real_xclip) || return 1
    "$real_xclip" "$@"
    return
  fi
  local args=("$@")
  local mode=""
  local type=""
  local selection=""

  local i=0
  while [ $i -lt ${#args[@]} ]; do
    case "${args[$i]}" in
      -o) mode="out" ;;
      -i) mode="in" ;;
      -t) i=$((i + 1)); type="${args[$i]:-}" ;;
      -selection) i=$((i + 1)); selection="${args[$i]:-}" ;;
    esac
    i=$((i + 1))
  done

  if [ "$mode" = "out" ]; then
    case "$type" in
      TARGETS)
        local img="$RPASTE_IMAGES/latest.png"
        if [ -f "$img" ]; then
          printf 'TARGETS\nimage/png\ntext/plain\n'
        else
          printf 'TARGETS\ntext/plain\n'
        fi
        ;;
      image/png)
        local img="$RPASTE_IMAGES/latest.png"
        [ -f "$img" ] || exit 1
        cat "$img"
        ;;
      text/plain|"")
        local real_xclip
        real_xclip=$(_find_real_xclip) || { printf ''; exit 0; }
        "$real_xclip" "$@"
        ;;
      *)
        exit 1
        ;;
    esac
  elif [ "$mode" = "in" ]; then
    local real_xclip
    real_xclip=$(_find_real_xclip) || exit 0
    "$real_xclip" "$@"
  else
    local real_xclip
    real_xclip=$(_find_real_xclip) || exit 0
    "$real_xclip" "$@"
  fi
}

_find_real_xclip() {
  python_helper rpaste_display.py real-xclip
}

# ---------------------------------------------------------------------------
# Subcommand: shim-install
# Install xclip shim symlink on Linux.
# ---------------------------------------------------------------------------

cmd_shim_install() {
  local bin_dir="${1:-$HOME/.local/bin}"
  local self
  self=$(self_path)
  mkdir -p "$bin_dir"

  case "$(uname -s)" in
    Linux)
      _install_shim "$bin_dir" "$self" xclip
      info "ensure $bin_dir is before /usr/bin in PATH"
      ;;
    Darwin)
      info "no shim needed on macOS (DYLD injection handles NSPasteboard)"
      ;;
  esac
}

_install_shim() {
  local bin_dir=$1 self=$2 name=$3
  local target="$bin_dir/$name"
  if [ -e "$target" ] && [ "$(realpath "$target" 2>/dev/null)" != "$self" ]; then
    info "backing up existing $target → ${target}.real"
    mv "$target" "${target}.real"
  fi
  ln -sf "$self" "$target"
  info "installed $name shim: $target → $self"
}

# ---------------------------------------------------------------------------
# Subcommand: inject-build
# Compile the DYLD_INSERT_LIBRARIES dylib for macOS NSPasteboard interception.
# ---------------------------------------------------------------------------

compile_if_stale() {
  local src=$1 dest=$2 temporary
  shift 2
  [ -f "$src" ] || die "build source is missing: $src"
  [ ! -f "$dest" ] || [ ! "$dest" -nt "$src" ] || return 0
  temporary=$(mktemp "$RPASTE_STATE/build-XXXXXX")
  if clang "$@" -framework AppKit -o "$temporary" "$src"; then
    chmod 700 "$temporary"
    mv "$temporary" "$dest"
    info "built: $dest"
  else
    rm -f "$temporary"
    die "native build failed (Xcode CLT required)"
  fi
}

cmd_inject_build() {
  [ "$(uname -s)" = "Darwin" ] || { info "inject-build is macOS only"; return 0; }

  local rpaste_dir
  rpaste_dir=$(dirname "$(self_path)")
  mkdir -p "$RPASTE_STATE"
  compile_if_stale "$rpaste_dir/rpaste-inject.m" "$RPASTE_STATE/rpaste-inject.dylib" -dynamiclib
  compile_if_stale "$rpaste_dir/rpaste-get.m" "$RPASTE_STATE/rpaste-get"
}

# ---------------------------------------------------------------------------
# Subcommand: inject-env
# Print the shell snippet that loads the dylib in SSH sessions.
# ---------------------------------------------------------------------------

cmd_inject_env() {
  cat <<'EOF'
# rpaste — load NSPasteboard shim in SSH sessions (added by rpaste install)
if [ -n "${SSH_CONNECTION:-}" ] && [ -f "${XDG_STATE_HOME:-$HOME/.local/state}/rpaste/rpaste-inject.dylib" ]; then
  export DYLD_INSERT_LIBRARIES="${XDG_STATE_HOME:-$HOME/.local/state}/rpaste/rpaste-inject.dylib${DYLD_INSERT_LIBRARIES:+:$DYLD_INSERT_LIBRARIES}"
fi
EOF
}

_RPASTE_PROFILE_MARKER="# rpaste — load NSPasteboard shim in SSH sessions"

_inject_env_install() {
  local dylib="$RPASTE_STATE/rpaste-inject.dylib"
  [ -f "$dylib" ] || return 0

  local snippet
  snippet=$(cmd_inject_env)

  local rc="$HOME/.zshrc"
  [ -f "$rc" ] || rc="$HOME/.bashrc"
  [ -f "$rc" ] || rc="$HOME/.zshrc"

  if grep -qF "$_RPASTE_PROFILE_MARKER" "$rc" 2>/dev/null; then
    info "shell profile already has DYLD snippet ($rc)"
  else
    printf '\n%s\n' "$snippet" >> "$rc"
    info "added DYLD snippet to $rc"
  fi
}

_inject_env_remove() {
  for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
    [ -f "$rc" ] || continue
    if grep -qF "$_RPASTE_PROFILE_MARKER" "$rc" 2>/dev/null; then
      local tmp="$rc.rpaste-bak"
      # Remove the marker line and the following 3 lines (the if/export/fi block)
      awk -v marker="$_RPASTE_PROFILE_MARKER" '
        $0 ~ marker { skip=3; next }
        skip > 0 { skip--; next }
        { print }
      ' "$rc" > "$tmp" && mv "$tmp" "$rc"
      info "removed DYLD snippet from $rc"
    fi
  done
}

# ---------------------------------------------------------------------------
# Subcommand: status
# ---------------------------------------------------------------------------

cmd_status() {
  printf 'rpaste state dir: %s\n' "$RPASTE_STATE"
  printf 'socket tunnel:    %s\n' "${RPASTE_SOCKET:-(none; reverse SSH fallback)}"
  if [ -n "${TMUX:-}" ]; then
    printf 'tmux method:      %s\n' "$(tmux show-options -qv @rpaste-method 2>/dev/null || true)"
  fi
  if [ -f "$RPASTE_IMAGES/latest.png" ]; then
    local size
    size=$(wc -c < "$RPASTE_IMAGES/latest.png" | tr -d ' ')
    local target
    target=$(readlink "$RPASTE_IMAGES/latest.png" 2>/dev/null || echo "?")
    printf 'latest image:     %s (%s bytes)\n' "$target" "$size"
  else
    printf 'latest image:     (none)\n'
  fi
  printf 'platform:         %s\n' "$(uname -s)"
  if [ -n "${SSH_CONNECTION:-}" ]; then
    local ip
    ip=$(ssh_source_ip)
    printf 'ssh source:       %s (%s)\n' "$(resolve_host "$ip")" "$ip"
  else
    printf 'ssh source:       (not in SSH session)\n'
  fi
  case "$(uname -s)" in
    Linux)
      printf 'xclip shim:       '
      if [ -L "$HOME/.local/bin/xclip" ]; then
        printf 'yes (%s)\n' "$(readlink "$HOME/.local/bin/xclip")"
      else
        printf 'no\n'
      fi
      ;;
    Darwin)
      printf 'dylib:            '
      local dylib="$RPASTE_STATE/rpaste-inject.dylib"
      if [ -f "$dylib" ]; then
        printf '%s\n' "$dylib"
      else
        printf '(not built)\n'
      fi
      printf 'DYLD active:      '
      if [ -n "${DYLD_INSERT_LIBRARIES:-}" ] && printf '%s' "$DYLD_INSERT_LIBRARIES" | grep -q rpaste-inject; then
        printf 'yes\n'
      else
        printf 'no\n'
      fi
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Subcommand: clean
# ---------------------------------------------------------------------------

cmd_clean() {
  local keep="${1:-10}"
  ensure_dirs
  local count=0
  while IFS= read -r f; do
    [ "$f" = "$RPASTE_IMAGES/latest.png" ] && continue
    rm -f "$f"
    count=$((count + 1))
  done < <(ls -1t "$RPASTE_IMAGES"/clipboard-*.png 2>/dev/null | tail -n +$((keep + 1)))
  info "cleaned $count old images (keeping $keep)"
}

# ---------------------------------------------------------------------------
# Subcommand: install
# ---------------------------------------------------------------------------

cmd_install() {
  local bin_dir="$HOME/.local/bin" profile=1 check=1 native=1
  for arg in "$@"; do
    case "$arg" in
      --no-profile) profile=0 ;;
      --no-check) check=0 ;;
      --no-native) native=0 ;;
      --*) die "unknown install option: $arg" ;;
      *) bin_dir=$arg ;;
    esac
  done
  local self
  self=$(self_path)

  ensure_dirs

  # 1. Link rpaste into PATH
  mkdir -p "$bin_dir"
  local link="$bin_dir/rpaste"
  if [ -L "$link" ] && [ "$(realpath "$link" 2>/dev/null)" = "$self" ]; then
    info "rpaste already in $bin_dir"
  elif [ -d "$link" ]; then
    die "$link is a directory; refusing to nest the rpaste link inside it"
  else
    ln -sf "$self" "$link"
    info "linked: $link → $self"
  fi

  # 2. Optional native setup (the dotfiles installer handles dependencies).
  if [ "$native" = 1 ]; then
    case "$(uname -s)" in
    Linux)
      cmd_shim_install "$bin_dir"
      if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        command -v wl-paste >/dev/null 2>&1 \
          || info "warning: wl-paste not found (sudo apt install wl-clipboard)"
      fi
      ;;
    Darwin)
      cmd_inject_build
      [ "$profile" = 0 ] || _inject_env_install
      ;;
  esac
  fi

  # 3. Verify SSH reverse access (if in an SSH session)
  if [ "$check" = 0 ]; then
    info "setup complete"
    return
  elif [ -n "${SSH_CONNECTION:-}" ]; then
    local ip host
    ip=$(ssh_source_ip)
    host=$(resolve_host "$ip")
    info "SSH source detected: $host ($ip)"
    info "testing reverse SSH..."
    if ssh -o BatchMode=yes -o ConnectTimeout=3 "$host" 'echo ok' >/dev/null 2>&1; then
      info "reverse SSH to $host: ok"
      if ssh -o BatchMode=yes -o ConnectTimeout=3 "$host" '
        command -v rpaste >/dev/null 2>&1 || [ -x "$HOME/.local/bin/rpaste" ]
      ' 2>/dev/null; then
        info "rpaste on $host: found"
      else
        info "warning: rpaste not found on $host"
        info "  install rpaste on $host too (it needs 'rpaste get' to extract clipboard)"
      fi
    else
      info "warning: reverse SSH to $host failed"
      info "  rpaste needs SSH access back to your local machine"
    fi
  else
    info "not in SSH session — this machine is the clipboard source"
  fi

  info "done. run 'rpaste status' to verify."
}

# ---------------------------------------------------------------------------
# Subcommand: uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
  local bin_dir="${1:-$HOME/.local/bin}"

  # Remove xclip shim
  if [ -L "$bin_dir/xclip" ]; then
    local target
    target=$(realpath "$bin_dir/xclip" 2>/dev/null || readlink -f "$bin_dir/xclip" 2>/dev/null || echo "")
    local self
    self=$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}")
    if [ "$target" = "$self" ]; then
      rm -f "$bin_dir/xclip"
      info "removed xclip shim"
      if [ -f "$bin_dir/xclip.real" ]; then
        mv "$bin_dir/xclip.real" "$bin_dir/xclip"
        info "restored original xclip"
      fi
    fi
  fi

  # Remove DYLD snippet from shell profile
  _inject_env_remove

  # Remove rpaste link (but not the repo itself)
  if [ -L "$bin_dir/rpaste" ]; then
    rm -f "$bin_dir/rpaste"
    info "removed rpaste from $bin_dir"
  fi

  info "uninstalled. state dir left at $RPASTE_STATE (remove manually if desired)."
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'EOF'
rpaste — content bridge for pasting images into terminal agents over SSH

Usage: rpaste <command> [args]

Commands:
  install          One-time setup: link into PATH, build dylib, install shims
  uninstall        Remove shims, DYLD snippet, and PATH link
  get              Extract clipboard image → stdout (run on machine with display)
  stage            Read image from stdin → staging dir, print path
  pull [host]      Pull clipboard image from SSH source (or given host) → stage
  local            Stage the clipboard on this machine, print the image path
  paste [host]     Pull + stage + publish to the optional native clipboard
  ssh [opts] host  Open an interactive SSH shell with a clipboard socket tunnel
  run -- command  Launch an agent with tmux registration and optional native support
  tmux-paste      Deliver to a pane (called by the tmux bindings)
  serve [args]     Act as xclip shim (called when symlinked as xclip)
  shim-install     Install xclip shim symlink (Linux only)
  inject-build     Build the NSPasteboard dylib (macOS only)
  inject-env       Print shell snippet for loading the dylib
  status           Show rpaste state
  clean [N]        Remove old staged images, keeping N most recent (default 10)

Workflow:
  1. Connect with rssh user@host (or use existing reverse SSH access).
  2. Start Claude Code or Codex inside tmux; copy an image locally.
  3. Ctrl+V uses @rpaste-method; prefix+v forces path; prefix+V forces native.
  Native support is optional: dotfiles/install.sh --rpaste-native, restart agent.
EOF
  return 0
}

# Handle being called as xclip shim (symlink named 'xclip' pointing to rpaste)
called_as=$(basename "$0")
if [ "$called_as" = "xclip" ]; then
  cmd_serve "$@"
  exit $?
fi

[ $# -ge 1 ] || { usage; exit 1; }
cmd="$1"; shift

case "$cmd" in
  install)      cmd_install "$@" ;;
  uninstall)    cmd_uninstall "$@" ;;
  get)          cmd_get "$@" ;;
  get-text)     cmd_get_text "$@" ;;
  pull-text)    cmd_pull_text "$@" ;;
  local)        cmd_local "$@" ;;
  stage)        cmd_stage "$@" ;;
  pull)         cmd_pull "$@" ;;
  paste)        cmd_paste "$@" ;;
  run)          cmd_run "$@" ;;
  publish)      cmd_publish "$@" ;;
  real-xclip)   _find_real_xclip ;;
  tmux-paste)   python_helper rpaste_tmux.py "$@" ;;
  ssh)          python_helper rpaste_transport.py ssh "$RPASTE_STATE/source.sock" "$(self_path)" "$@" ;;
  ssh-auto)     python_helper rpaste_transport.py ssh-auto "$RPASTE_STATE/source.sock" "$(self_path)" "$@" ;;
  kitty-ssh)     python_helper rpaste_transport.py kitty-ssh "$RPASTE_STATE/source.sock" "$(self_path)" "$@" ;;
  serve)        cmd_serve "$@" ;;
  shim-install) cmd_shim_install "$@" ;;
  inject-build) cmd_inject_build "$@" ;;
  inject-env)   cmd_inject_env "$@" ;;
  status)       cmd_status "$@" ;;
  clean)        cmd_clean "$@" ;;
  -h|--help|help) usage ;;
  *)            die "unknown command: $cmd (try rpaste --help)" ;;
esac
